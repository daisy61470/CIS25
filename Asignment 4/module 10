// Program: Product class that shows how constructors and destructors
// manage the lifecycle of objects in C++.

#include <iostream>
#include <string>
using namespace std;

class Product {
private:
    // Private attributes: id, name, and price
    int id;
    string name;
    float price;

public:
    // Constructor: initializes the attributes and displays a message
    Product(int i, string n, float p) {
        id = i;
        name = n;
        price = p;
        cout << "Constructor called for product: " << name << endl;
    }

    // Destructor: displays a message when the object is destroyed
    ~Product() {
        cout << "Destructor called for product: " << name << endl;
    }

    // Method to display the product's information
    void printDetails() {
        cout << "ID: " << id << ", Name: " << name
             << ", Price: $" << price << endl;
    }
};

int main() {
    cout << "--- Program start ---" << endl;

    // Create a Product object with values of my choice
    // and call printDetails() to verify the data
    Product p1(2049, "Wireless Mouse", 24.99f);
    p1.printDetails();

    // Inner scope demonstrates the object lifecycle: p2 is
    // destroyed as soon as the block ends, so its destructor
    // message prints before the program finishes
    {
        Product p2(2050, "USB-C Cable", 12.75f);
        p2.printDetails();
    }   // p2's destructor runs here

    cout << "--- Program end ---" << endl;
    return 0;
}   // p1's destructor runs here, when main ends

