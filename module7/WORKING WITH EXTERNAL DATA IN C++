// ============================================================================
// MODULE 7: WORKING WITH EXTERNAL DATA IN C++
// Course: CIS 25
// Name:   Daisy Schall
//
// Dataset: "Nvidia GPU Sales Data 2026" (public, synthetic) from Kaggle
// Source:  https://www.kaggle.com/datasets/uditjain13/nvidia-gpu-sales-synthetic-2026
// File:    nvidia_gpu_sales_synthetic_2026.csv
//
// FILE STRUCTURE
// --------------
// The CSV has 1 header row followed by 7,000 data rows.
// Every row holds 17 comma-separated fields, with no quoted values and no
// embedded commas, so a simple getline(stream, field, ',') split is safe.
//
// Column order in the raw file:
//   [0]  sale_id                     [9]  msrp_usd
//   [1]  sale_date                   [10] avg_street_price_usd
//   [2]  gpu_model                   [11] price_premium_pct
//   [3]  gpu_family                  [12] stock_status
//   [4]  launch_year                 [13] customer_satisfaction_score
//   [5]  region                      [14] warranty_months
//   [6]  sales_channel               [15] bundle_addon
//   [7]  customer_segment            [16] revenue_usd
//   [8]  units_sold
//
// FIELDS USED BY THIS PROGRAM (7 of 17; assignment requires at least 5)
//   sale_date, gpu_model, region, units_sold, msrp_usd,
//   customer_satisfaction_score, revenue_usd
//
// RECORDS LOADED: 15 (assignment requires at least 10)
//
// Data file accepted as either nvidia_gpu_sales_synthetic_2026.csv or
// nvidia_gpu_sales_synthetic_2026.txt (identical bytes; Canvas requires .txt)
//
// Compile: g++ -std=c++17 -Wall module7.cpp -o module7
// Run:     ./module7
// ============================================================================

#include <iostream>
#include <fstream>    // ifstream, for reading the external .csv file
#include <sstream>    // istringstream, for splitting one CSV line into fields
#include <string>
#include <vector>
#include <iomanip>    // setw, fixed, setprecision, for the formatted table
using namespace std;

// ----------------------------------------------------------------------------
// CLASS 1: GpuSale
// Represents ONE row of the dataset. Data members are private so the raw values
// can only be read through the public getters (encapsulation).
// ----------------------------------------------------------------------------
class GpuSale {
private:
    string saleDate;         // field [1]  e.g. "2024-01-12"
    string gpuModel;         // field [2]  e.g. "RTX 4090"
    string region;           // field [5]  e.g. "North America"
    int    unitsSold;        // field [8]  integer count
    double msrpUsd;          // field [9]  manufacturer suggested retail price
    double satisfaction;     // field [13] customer rating, 1.0 to 5.0
    double revenueUsd;       // field [16] total dollars for the sale

public:
    // Default constructor: gives every numeric member a safe starting value.
    GpuSale()
        : saleDate(""), gpuModel(""), region(""),
          unitsSold(0), msrpUsd(0.0), satisfaction(0.0), revenueUsd(0.0) {}

    // Parameterized constructor: builds a fully populated record.
    GpuSale(const string& date, const string& model, const string& reg,
            int units, double msrp, double score, double revenue)
        : saleDate(date), gpuModel(model), region(reg),
          unitsSold(units), msrpUsd(msrp), satisfaction(score),
          revenueUsd(revenue) {}

    // Getters. Marked const so they cannot modify the object.
    string getSaleDate()     const { return saleDate; }
    string getGpuModel()     const { return gpuModel; }
    string getRegion()       const { return region; }
    int    getUnitsSold()    const { return unitsSold; }
    double getMsrpUsd()      const { return msrpUsd; }
    double getSatisfaction() const { return satisfaction; }
    double getRevenueUsd()   const { return revenueUsd; }

    // Prints this single record as one aligned row of the output table.
    void display() const {
        cout << left  << setw(12) << saleDate
             << left  << setw(20) << gpuModel
             << left  << setw(26) << region
             << right << setw(7)  << unitsSold
             << right << setw(12) << fixed << setprecision(2) << msrpUsd
             << right << setw(9)  << fixed << setprecision(1) << satisfaction
             << right << setw(15) << fixed << setprecision(2) << revenueUsd
             << endl;
    }
};

// ----------------------------------------------------------------------------
// CLASS 2: SalesDataset
// Owns the collection of GpuSale objects and all the file handling logic.
// ----------------------------------------------------------------------------
class SalesDataset {
private:
    vector<GpuSale> records;    // every loaded row lives here
    string headerLine;          // the raw header, kept for reference/printing

    // Helper: chop one CSV line into its individual fields.
    // The dataset has no quoted fields, so splitting on every comma is correct.
    static vector<string> splitLine(const string& line, char delimiter = ',') {
        vector<string> fields;
        istringstream stream(line);
        string field;
        while (getline(stream, field, delimiter)) {
            fields.push_back(field);
        }
        return fields;
    }

public:
    // Reports whether a file can be opened for reading.
    static bool fileExists(const string& filename) {
        ifstream test(filename);
        return test.good();
    }

    // Opens the data file, skips the header, and converts each data row into a
    // GpuSale object. Stops once maxRecords rows have been stored.
    // Returns false when the file cannot be opened.
    bool loadFromFile(const string& filename, int maxRecords) {
        ifstream inFile(filename);
        if (!inFile) {
            cerr << "ERROR: could not open \"" << filename << "\"" << endl;
            return false;
        }

        // Row 1 of the file is the header, so read it away before the loop.
        getline(inFile, headerLine);

        string line;
        while (records.size() < static_cast<size_t>(maxRecords)
               && getline(inFile, line)) {

            if (line.empty()) continue;               // guard against blank lines

            vector<string> f = splitLine(line);
            if (f.size() < 17) continue;              // guard against short rows

            // Pull only the seven columns this program needs, converting the
            // numeric ones from text to int/double.
            GpuSale record(
                f[1],              // sale_date
                f[2],              // gpu_model
                f[5],              // region
                stoi(f[8]),        // units_sold
                stod(f[9]),        // msrp_usd
                stod(f[13]),       // customer_satisfaction_score
                stod(f[16])        // revenue_usd
            );
            records.push_back(record);
        }

        inFile.close();                                // release the file handle
        return true;
    }

    int getCount() const { return static_cast<int>(records.size()); }

    // Prints the column headings, then every stored record.
    void displayAll() const {
        cout << string(101, '=') << endl;
        cout << "  NVIDIA GPU SALES 2026  |  " << records.size()
             << " records loaded from Kaggle CSV" << endl;
        cout << string(101, '=') << endl;

        cout << left  << setw(12) << "SALE DATE"
             << left  << setw(20) << "GPU MODEL"
             << left  << setw(26) << "REGION"
             << right << setw(7)  << "UNITS"
             << right << setw(12) << "MSRP (USD)"
             << right << setw(9)  << "RATING"
             << right << setw(15) << "REVENUE (USD)"
             << endl;
        cout << string(101, '-') << endl;

        for (const GpuSale& record : records) {
            record.display();
        }
        cout << string(101, '=') << endl;
    }

    // A short aggregate report proving the parsed numbers are usable as numbers.
    void displaySummary() const {
        if (records.empty()) return;

        int    totalUnits   = 0;
        double totalRevenue = 0.0;
        double ratingSum    = 0.0;
        GpuSale best        = records[0];   // record with the highest revenue

        for (const GpuSale& record : records) {
            totalUnits   += record.getUnitsSold();
            totalRevenue += record.getRevenueUsd();
            ratingSum    += record.getSatisfaction();
            if (record.getRevenueUsd() > best.getRevenueUsd()) {
                best = record;
            }
        }

        double avgRating = ratingSum / records.size();

        cout << "\nSUMMARY OF LOADED RECORDS" << endl;
        cout << string(101, '-') << endl;
        cout << "Total units sold ................ " << totalUnits << endl;
        cout << "Total revenue ................... $" << fixed << setprecision(2)
             << totalRevenue << endl;
        cout << "Average satisfaction score ...... " << fixed << setprecision(2)
             << avgRating << " / 5.0" << endl;
        cout << "Highest revenue sale ............ " << best.getGpuModel()
             << " in " << best.getRegion()
             << " on " << best.getSaleDate()
             << " ($" << fixed << setprecision(2) << best.getRevenueUsd() << ")"
             << endl;
        cout << string(101, '-') << endl;
    }
};

// ----------------------------------------------------------------------------
// MAIN
// ----------------------------------------------------------------------------
int main() {
    const int MAX_RECORDS = 15;   // assignment minimum is 10

    // Two accepted names for the same dataset. The original Kaggle download is
    // a .csv, while the copy submitted to Canvas carries a .txt extension.
    // The bytes are identical, so the program accepts whichever one is present.
    const string CANDIDATES[] = {
        "nvidia_gpu_sales_synthetic_2026.csv",
        "nvidia_gpu_sales_synthetic_2026.txt"
    };
    const int NUM_CANDIDATES = 2;

    string dataFile = "";
    for (int i = 0; i < NUM_CANDIDATES; i++) {
        if (SalesDataset::fileExists(CANDIDATES[i])) {
            dataFile = CANDIDATES[i];
            break;
        }
    }

    if (dataFile.empty()) {
        cerr << "ERROR: dataset not found." << endl;
        cout << "Place " << CANDIDATES[0] << " (or " << CANDIDATES[1]
             << ") in the same folder as the program." << endl;
        return 1;
    }

    SalesDataset dataset;

    // Attempt the load; stop the program cleanly if the file cannot be read.
    if (!dataset.loadFromFile(dataFile, MAX_RECORDS)) {
        return 1;
    }

    cout << "Successfully loaded " << dataset.getCount()
         << " records from " << dataFile << "\n" << endl;

    dataset.displayAll();      // requirement: display the data in a readable format
    dataset.displaySummary();  // extra: proves the numeric fields parsed correctly

    return 0;
}

