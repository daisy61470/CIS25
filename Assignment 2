//       cout << "Largest number: " << n2  // printed n2, missing semicolon
//   }
//
// The nested form below finds the max in at most TWO comparisons.

#include <iostream>

int main() {
    std::ios::sync_with_stdio(false);

    // FIX: separate each variable with commas and drop the stray trailing comma
    //      (original: "float n1 n2 n3,").
    float n1, n2, n3;

    std::cout << "Enter three numbers: ";

    // FIX: use the extraction operator ">>" for every variable, and read into
    //      n1, n2, n3 (original: "cin >> n1 > n1 > n3;" used ">" and read n1 twice).
    std::cin >> n1 >> n2 >> n3;

    // FIX: use "==" style comparison logic via nested ifs instead of "="
    //      assignment (original: "if(n1 = n2 && n1 >= n3)").
    if (n1 >= n2) {
        // n1 is at least as big as n2; the winner is n1 or n3.
        if (n1 >= n3) {
            std::cout << "Largest number: " << n1 << '\n';
        } else {
            std::cout << "Largest number: " << n3 << '\n';
        }
    } else {
        // n2 is bigger than n1; the winner is n2 or n3.
        if (n2 >= n3) {
            // FIX: print n2 here (original printed n1 inside the n2 branch).
            std::cout << "Largest number: " << n2 << '\n';
        } else {
            // FIX: print n3 and terminate the statement with ";"
            //      (original printed n2 and was missing its semicolon).
            std::cout << "Largest number: " << n3 << '\n';
        }
    }

    return 0;
}

