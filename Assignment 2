// ============================================================================
// CIS 25 - Module 4, Part 1
// Topic: Debugging, if-statements
// Task : Build a simple menu using if statements.
//
// Design notes:
//   * A single read of the option, validated with plain if / else-if chains
//     (the construct this module teaches).
//   * std::ios::sync_with_stdio(false) speeds up console I/O; the menu text is
//     emitted in one streamed write to avoid repeated flushes.
// ============================================================================
#include <iostream>

int main() {
    std::ios::sync_with_stdio(false);   // faster, unbuffered-friendly console I/O

    int choice = 0;

    // One streamed write for the whole menu (fewer flushes than line-by-line).
    std::cout << "===== MAIN MENU =====\n"
                 "1. Say Hello\n"
                 "2. Show Today's Special\n"
                 "3. Show Store Hours\n"
                 "4. Exit\n"
                 "Choose an option: ";
    std::cin >> choice;

    // if / else-if chain: exactly one branch runs.
    if (choice == 1) {
        std::cout << "Hello, welcome to the shop!\n";
    } else if (choice == 2) {
        std::cout << "Today's special is fresh apple pie.\n";
    } else if (choice == 3) {
        std::cout << "We are open 9:00 AM to 6:00 PM.\n";
    } else if (choice == 4) {
        std::cout << "Goodbye!\n";
    } else {
        // Any value outside 1-4 (or bad input) lands here.
        std::cout << "Invalid option. Please choose 1-4.\n";
    }

    return 0;
}

